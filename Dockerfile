FROM node:20-alpine AS builder
WORKDIR /app

# cache dependency installation
COPY package*.json ./
RUN npm ci

COPY . .

ARG CLOUDFLARE_R2_ACCESS_KEY_ID
ARG CLOUDFLARE_R2_SECRET_ACCESS_KEY
ARG CLOUDFLARE_R2_TOKEN_VALUE
ARG CLOUDFLARE_R2_BUCKET_NAME
ARG CLOUDFLARE_R2_S3_ENDPOINT
ARG CLOUDFLARE_R2_PROFILE_IMAGE_OBJECT_KEY
ARG CLOUDFLARE_R2_PROJECT_ONE_MEDIA_OBJECT_KEY
ARG CLOUDFLARE_R2_THESIS_PAPER_OBJECT_KEY
ARG VITE_PROJECT_ONE_YOUTUBE_URL
ARG VITE_PROJECT_TWO_YOUTUBE_URL
ARG VITE_PROJECT_ONE_FACEBOOK_URL
ARG VITE_PROJECT_THREE_FACEBOOK_URL

ENV CLOUDFLARE_R2_ACCESS_KEY_ID=$CLOUDFLARE_R2_ACCESS_KEY_ID \
    CLOUDFLARE_R2_SECRET_ACCESS_KEY=$CLOUDFLARE_R2_SECRET_ACCESS_KEY \
    CLOUDFLARE_R2_TOKEN_VALUE=$CLOUDFLARE_R2_TOKEN_VALUE \
    CLOUDFLARE_R2_BUCKET_NAME=$CLOUDFLARE_R2_BUCKET_NAME \
    CLOUDFLARE_R2_S3_ENDPOINT=$CLOUDFLARE_R2_S3_ENDPOINT \
    CLOUDFLARE_R2_PROFILE_IMAGE_OBJECT_KEY=$CLOUDFLARE_R2_PROFILE_IMAGE_OBJECT_KEY \
    CLOUDFLARE_R2_PROJECT_ONE_MEDIA_OBJECT_KEY=$CLOUDFLARE_R2_PROJECT_ONE_MEDIA_OBJECT_KEY \
    CLOUDFLARE_R2_THESIS_PAPER_OBJECT_KEY=$CLOUDFLARE_R2_THESIS_PAPER_OBJECT_KEY \
    VITE_PROJECT_ONE_YOUTUBE_URL=$VITE_PROJECT_ONE_YOUTUBE_URL \
    VITE_PROJECT_TWO_YOUTUBE_URL=$VITE_PROJECT_TWO_YOUTUBE_URL \
    VITE_PROJECT_ONE_FACEBOOK_URL=$VITE_PROJECT_ONE_FACEBOOK_URL \
    VITE_PROJECT_THREE_FACEBOOK_URL=$VITE_PROJECT_THREE_FACEBOOK_URL

RUN apk add --no-cache aws-cli

RUN set -eux; \
    mkdir -p public/r2; \
    if [ -n "$CLOUDFLARE_R2_ACCESS_KEY_ID" ] && [ -n "$CLOUDFLARE_R2_SECRET_ACCESS_KEY" ] && [ -n "$CLOUDFLARE_R2_BUCKET_NAME" ] && [ -n "$CLOUDFLARE_R2_S3_ENDPOINT" ]; then \
      export AWS_ACCESS_KEY_ID="$CLOUDFLARE_R2_ACCESS_KEY_ID"; \
      export AWS_SECRET_ACCESS_KEY="$CLOUDFLARE_R2_SECRET_ACCESS_KEY"; \
      if [ -n "$CLOUDFLARE_R2_TOKEN_VALUE" ]; then export AWS_SESSION_TOKEN="$CLOUDFLARE_R2_TOKEN_VALUE"; fi; \
      if [ -n "$CLOUDFLARE_R2_PROFILE_IMAGE_OBJECT_KEY" ]; then \
        PROFILE_IMAGE_FILE="$(basename "$CLOUDFLARE_R2_PROFILE_IMAGE_OBJECT_KEY")"; \
        aws s3 cp "s3://${CLOUDFLARE_R2_BUCKET_NAME}/${CLOUDFLARE_R2_PROFILE_IMAGE_OBJECT_KEY}" "public/r2/${PROFILE_IMAGE_FILE}" --endpoint-url "$CLOUDFLARE_R2_S3_ENDPOINT"; \
        export VITE_PROFILE_IMAGE_URL="/r2/${PROFILE_IMAGE_FILE}"; \
      fi; \
      if [ -n "$CLOUDFLARE_R2_PROJECT_ONE_MEDIA_OBJECT_KEY" ]; then \
        PROJECT_ONE_MEDIA_FILE="$(basename "$CLOUDFLARE_R2_PROJECT_ONE_MEDIA_OBJECT_KEY")"; \
        aws s3 cp "s3://${CLOUDFLARE_R2_BUCKET_NAME}/${CLOUDFLARE_R2_PROJECT_ONE_MEDIA_OBJECT_KEY}" "public/r2/${PROJECT_ONE_MEDIA_FILE}" --endpoint-url "$CLOUDFLARE_R2_S3_ENDPOINT"; \
        export VITE_PROJECT_ONE_MEDIA_URL="/r2/${PROJECT_ONE_MEDIA_FILE}"; \
      fi; \
      if [ -n "$CLOUDFLARE_R2_THESIS_PAPER_OBJECT_KEY" ]; then \
        THESIS_PAPER_FILE="$(basename "$CLOUDFLARE_R2_THESIS_PAPER_OBJECT_KEY")"; \
        aws s3 cp "s3://${CLOUDFLARE_R2_BUCKET_NAME}/${CLOUDFLARE_R2_THESIS_PAPER_OBJECT_KEY}" "public/r2/${THESIS_PAPER_FILE}" --endpoint-url "$CLOUDFLARE_R2_S3_ENDPOINT"; \
        export VITE_THESIS_PAPER_URL="/r2/${THESIS_PAPER_FILE}"; \
      fi; \
    fi; \
    npm run build

FROM nginx:1.27-alpine AS portfolio
COPY --from=builder /app/dist /usr/share/nginx/html
COPY portfolio.nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

FROM caddy:2.10-alpine AS caddy
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
EXPOSE 443
