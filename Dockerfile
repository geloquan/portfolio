FROM node:20-alpine AS builder
WORKDIR /app

# cache dependency installation
COPY package*.json ./
RUN npm ci

COPY . .

ARG CLOUDFLARE_R2_PROFILE_IMAGE_URL
ARG CLOUDFLARE_R2_PROJECT_ONE_MEDIA_URL
ARG CLOUDFLARE_R2_PROJECT_TWO_MEDIA_URL
ARG CLOUDFLARE_R2_PROJECT_THREE_MEDIA_URL
ARG CLOUDFLARE_R2_PROJECT_FOUR_MEDIA_URL
ARG VITE_PROJECT_ONE_YOUTUBE_URL
ARG VITE_PROJECT_TWO_YOUTUBE_URL
ARG VITE_PROJECT_ONE_FACEBOOK_URL
ARG VITE_PROJECT_THREE_FACEBOOK_URL

ENV CLOUDFLARE_R2_PROFILE_IMAGE_URL=$CLOUDFLARE_R2_PROFILE_IMAGE_URL \
    CLOUDFLARE_R2_PROJECT_ONE_MEDIA_URL=$CLOUDFLARE_R2_PROJECT_ONE_MEDIA_URL \
    CLOUDFLARE_R2_PROJECT_TWO_MEDIA_URL=$CLOUDFLARE_R2_PROJECT_TWO_MEDIA_URL \
    CLOUDFLARE_R2_PROJECT_THREE_MEDIA_URL=$CLOUDFLARE_R2_PROJECT_THREE_MEDIA_URL \
    CLOUDFLARE_R2_PROJECT_FOUR_MEDIA_URL=$CLOUDFLARE_R2_PROJECT_FOUR_MEDIA_URL \
    VITE_PROJECT_ONE_YOUTUBE_URL=$VITE_PROJECT_ONE_YOUTUBE_URL \
    VITE_PROJECT_TWO_YOUTUBE_URL=$VITE_PROJECT_TWO_YOUTUBE_URL \
    VITE_PROJECT_ONE_FACEBOOK_URL=$VITE_PROJECT_ONE_FACEBOOK_URL \
    VITE_PROJECT_THREE_FACEBOOK_URL=$VITE_PROJECT_THREE_FACEBOOK_URL

RUN npm run build

FROM nginx:1.27-alpine AS portfolio
COPY --from=builder /app/dist /usr/share/nginx/html
COPY portfolio.nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

FROM caddy:2.10-alpine AS caddy
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
