FROM node:20-alpine AS builder
WORKDIR /app

# Cache dependency installation.
COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_PROFILE_IMAGE_URL
ARG VITE_PROJECT_FLAGSHIP_BENTO_ITEM_01_URL
ARG VITE_PROJECT_FLAGSHIP_BENTO_ITEM_02_URL
ARG VITE_PROJECT_FLAGSHIP_BENTO_ITEM_03_URL
ARG VITE_PROJECT_FLAGSHIP_BENTO_ITEM_04_URL
ARG VITE_PROJECT_FLAGSHIP_BENTO_ITEM_05_URL
ARG VITE_PROJECT_FLAGSHIP_BENTO_ITEM_06_URL
ARG VITE_PROJECT_FLAGSHIP_BENTO_ITEM_07_URL
ARG VITE_PROJECT_FLAGSHIP_BENTO_ITEM_08_URL
ARG VITE_THESIS_PAPER_URL
ARG VITE_CALENDLY_URL
ARG VITE_PROJECT_MEDICAL_ARTS_MEDIA_URL
ARG VITE_PROJECT_FLAGSHIP_MEDIA_URL
ARG VITE_PROJECT_SEASHELL_MEDIA_URL
ARG VITE_PROJECT_DOCTOR_DIRECTORY_MEDIA_URL
ARG VITE_PROJECT_ONE_YOUTUBE_URL
ARG VITE_PROJECT_TWO_YOUTUBE_URL
ARG VITE_PROJECT_ONE_FACEBOOK_URL
ARG VITE_PROJECT_THREE_FACEBOOK_URL

ENV VITE_PROFILE_IMAGE_URL=$VITE_PROFILE_IMAGE_URL \
    VITE_PROJECT_FLAGSHIP_BENTO_ITEM_01_URL=$VITE_PROJECT_FLAGSHIP_BENTO_ITEM_01_URL \
    VITE_PROJECT_FLAGSHIP_BENTO_ITEM_02_URL=$VITE_PROJECT_FLAGSHIP_BENTO_ITEM_02_URL \
    VITE_PROJECT_FLAGSHIP_BENTO_ITEM_03_URL=$VITE_PROJECT_FLAGSHIP_BENTO_ITEM_03_URL \
    VITE_PROJECT_FLAGSHIP_BENTO_ITEM_04_URL=$VITE_PROJECT_FLAGSHIP_BENTO_ITEM_04_URL \
    VITE_PROJECT_FLAGSHIP_BENTO_ITEM_05_URL=$VITE_PROJECT_FLAGSHIP_BENTO_ITEM_05_URL \
    VITE_PROJECT_FLAGSHIP_BENTO_ITEM_06_URL=$VITE_PROJECT_FLAGSHIP_BENTO_ITEM_06_URL \
    VITE_PROJECT_FLAGSHIP_BENTO_ITEM_07_URL=$VITE_PROJECT_FLAGSHIP_BENTO_ITEM_07_URL \
    VITE_PROJECT_FLAGSHIP_BENTO_ITEM_08_URL=$VITE_PROJECT_FLAGSHIP_BENTO_ITEM_08_URL \
    VITE_THESIS_PAPER_URL=$VITE_THESIS_PAPER_URL \
    VITE_CALENDLY_URL=$VITE_CALENDLY_URL \
    VITE_PROJECT_MEDICAL_ARTS_MEDIA_URL=$VITE_PROJECT_MEDICAL_ARTS_MEDIA_URL \
    VITE_PROJECT_FLAGSHIP_MEDIA_URL=$VITE_PROJECT_FLAGSHIP_MEDIA_URL \
    VITE_PROJECT_SEASHELL_MEDIA_URL=$VITE_PROJECT_SEASHELL_MEDIA_URL \
    VITE_PROJECT_DOCTOR_DIRECTORY_MEDIA_URL=$VITE_PROJECT_DOCTOR_DIRECTORY_MEDIA_URL \
    VITE_PROJECT_ONE_YOUTUBE_URL=$VITE_PROJECT_ONE_YOUTUBE_URL \
    VITE_PROJECT_TWO_YOUTUBE_URL=$VITE_PROJECT_TWO_YOUTUBE_URL \
    VITE_PROJECT_ONE_FACEBOOK_URL=$VITE_PROJECT_ONE_FACEBOOK_URL \
    VITE_PROJECT_THREE_FACEBOOK_URL=$VITE_PROJECT_THREE_FACEBOOK_URL

RUN npm run build

FROM nginx:1.27-alpine AS portfolio
COPY --from=builder /app/dist /usr/share/nginx/html
COPY portfolio.nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

FROM caddy:2.10-alpine AS caddy
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
EXPOSE 443
