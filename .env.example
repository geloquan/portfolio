# Copy this file to .env.local for Vite development or .env for Docker Compose.
# Put uploaded/local media under public/assets/media/ and use the matching
# browser path below. These values are public because they are bundled into
# the frontend.

# ------------------------------------------------------------------------------
# Project-local media
# ------------------------------------------------------------------------------
# The files below are optional. If a value is empty or the file is absent, the
# UI shows its normal "media not configured" placeholder.
VITE_PROFILE_IMAGE_URL=/assets/media/profile/profile.webp
VITE_PROJECT_FLAGSHIP_MEDIA_URL=/assets/media/projects/flagship/demo.mp4
VITE_PROJECT_FLAGSHIP_BENTO_ITEM_01_URL=/assets/media/projects/flagship/bento/01-chatbot.svg
VITE_PROJECT_FLAGSHIP_BENTO_ITEM_02_URL=/assets/media/projects/flagship/bento/02-agent-orchestrator.svg
VITE_PROJECT_FLAGSHIP_BENTO_ITEM_03_URL=/assets/media/projects/flagship/bento/03-multidatabase.svg
VITE_PROJECT_FLAGSHIP_BENTO_ITEM_04_URL=/assets/media/projects/flagship/bento/04-planning-execution.svg
VITE_PROJECT_FLAGSHIP_BENTO_ITEM_05_URL=/assets/media/projects/flagship/bento/05-autopilot.svg
VITE_PROJECT_FLAGSHIP_BENTO_ITEM_06_URL=/assets/media/projects/flagship/bento/06-local-by-design.svg
VITE_PROJECT_FLAGSHIP_BENTO_ITEM_07_URL=/assets/media/projects/flagship/bento/07-built-for-operators.svg
VITE_PROJECT_FLAGSHIP_BENTO_ITEM_08_URL=/assets/media/projects/flagship/bento/08-any-domain.svg
VITE_PROJECT_MEDICAL_ARTS_MEDIA_URL=/assets/media/projects/medical-arts/demo.mp4
VITE_PROJECT_SEASHELL_MEDIA_URL=/assets/media/projects/seashell/demo.png
VITE_PROJECT_DOCTOR_DIRECTORY_MEDIA_URL=/assets/media/projects/doctor-directory/demo.mp4
VITE_THESIS_PAPER_URL=/assets/media/research/seashell-computer-vision-thesis.pdf

# Optional external links shown by the portfolio.
VITE_CALENDLY_URL=https://calendly.com/your-handle
VITE_PROJECT_ONE_YOUTUBE_URL=
VITE_PROJECT_TWO_YOUTUBE_URL=
VITE_PROJECT_ONE_FACEBOOK_URL=
VITE_PROJECT_THREE_FACEBOOK_URL=

# ------------------------------------------------------------------------------
# Local/Docker runtime settings
# ------------------------------------------------------------------------------
# Caddy uses this for HTTPS certificate issuance. Include every hostname that
# points to this server, separated by commas.
SITE_HOSTNAMES=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Storage layout:
# public/assets/media/
# ├── profile/profile.webp
# ├── projects/flagship/demo.mp4
# ├── projects/flagship/bento/       <- the 8 item files above
# ├── projects/medical-arts/demo.mp4
# ├── projects/seashell/demo.png
# ├── projects/doctor-directory/demo.mp4
# └── research/seashell-computer-vision-thesis.pdf
#
# The repository already contains bundled logos, Bento-style doodles, the
# fallback portrait, resume PDF, and fallback thesis PDF. They do not need to
# be copied into this media directory.
